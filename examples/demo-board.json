        { "value": "lisbon", "label": "Lisbon", "detail": "Cheapest flights for most of the team.", "recommended": true },
        { "value": "krakow", "label": "Kraków", "detail": "Closest to the dev team." },
        { "value": "remote", "label": "Remote only" }
      ] },
    { "id": "days", "group": "basics", "title": "How many days?", "type": "number", "min": 1, "max": 5, "showIf": { "go": "yes" } },
