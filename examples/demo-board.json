      "options": [{ "value": "roadmap", "label": "2027 roadmap" }, { "value": "oncall", "label": "On-call rotation" }, { "value": "hiring", "label": "Hiring plan" }, { "value": "fun", "label": "Something fun" }] },
    { "id": "order", "group": "agenda", "title": "Rank the sessions by importance", "type": "rank",
      "body": "<pre class=\"mermaid\">flowchart LR\n  Roadmap --> Hiring --> Oncall</pre>",
      "options": [{ "value": "roadmap", "label": "Roadmap" }, { "value": "hiring", "label": "Hiring" }, { "value": "oncall", "label": "On-call" }] },
    { "id": "energy", "group": "extras", "title": "How tired is the team right now?", "type": "scale", "min": 1, "max": 5 },
    { "id": "food", "group": "extras", "title": "Any dietary needs I should know about?", "type": "text", "optional": true },
    { "id": "color", "group": "extras", "title": "Pick a team T-shirt colour", "type": "custom",
      "body": "<div style=\"display:flex;gap:8px\"><button class=\"btn ghost\" onclick=\"punchList.answer('color','teal')\">Teal</button><button class=\"btn ghost\" onclick=\"punchList.answer('color','orange')\">Orange</button></div>" }
  ]
}
